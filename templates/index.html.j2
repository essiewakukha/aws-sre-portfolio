<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{{ site_title }}</title>
  <style>body { font-family: system-ui, sans-serif; margin: 3rem; } h1 { color: {{ theme_colour }}; }</style>
</head>
<body>
  <h1>{{ site_title }}</h1>
  <p>By {{ owner_name }}</p>
  <p>Served by <strong>{{ ansible_hostname }}</strong>
     ({{ ansible_ec2_instance_id }}) in {{ ansible_ec2_placement_availability_zone }}</p>
  <ul>
{% for p in projects %}
    <li>{{ p.name }} — {{ p.stack | join(', ') }}</li>
{% endfor %}
  </ul>
  <footer>Deployed by Ansible from commit {{ git_sha }}</footer>
</body>
</html>